APP_ENV=local
APP_NAME=parallax-apAPI_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+asyncpg://parallax:parallax@localhost:5432/parallax
REDIS_URL=redis://localhost:6379/0
WORKER_HEARTBEAT_KEY=parallax:worker:heartbeat
WORKER_HEARTBEAT_TTL_SECONDS=30

# Replace this value outside local development. Minimum 32 characters.
JWT_SECRET=change-this-local-secret-before-sharing-123456
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Optional local seed command values (`python scripts/seed_demo.py`).
DEMO_OWNER_EMAIL=owner@example.com
DEMO_OWNER_PASSWORD=replace-with-a-local-demo-password
DEMO_OWNER_NAME=Parallax Owner
DEMO_WORKSPACE_NAME=Parallax Demo
DEMO_WORKSPACE_SLUG=parallax-demo

# Phase 4 adapters use deterministic mock responses by default. Set `real` to call vendors.
INTEGRATION_MODE=mock
INTEGRATION_TIMEOUT_SECONDS=10
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#engineering
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Agent-team service contract. The backend never lets the agent write to integrations.
AGENT_SERVICE_URL=http://host.docker.internal:8100
AGENT_SERVICE_API_KEY=
AGENT_MODE=fallback
AGENT_TIMEOUT_SECONDS=30
AGENT_FALLBACK_ENABLED=true

EXECUTION_MAX_ATTEMPTS=3
EXECUTION_LOCK_TTL_SECONDS=300
MISSION_SLA_MINUTES=60
# Local-only deterministic failure injection. Allowed: jira, notion, slack, or blank.
DEMO_FAILURE_PROVIDER=
